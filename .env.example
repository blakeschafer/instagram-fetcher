# Download settings
DOWNLOAD_ROOT=./downloads/instagram
MAX_WORKERS=5

# Whisper transcription
WHISPER_MODEL=base
ENABLE_TRANSCRIPTION=true

# Flask
SECRET_KEY=change-me-to-a-random-string
FLASK_HOST=0.0.0.0
FLASK_PORT=5000
FLASK_DEBUG=false

# Rate limiting
RATE_LIMIT_DEFAULT=10/minute
RATE_LIMIT_DOWNLOAD=3/minute

# Job cleanup
JOB_TTL_SECONDS=3600
